# Gemini API key used by the Express server for explanation generation.
# Obtain one from https://aistudio.google.com/app/apikey.
GEMINI_API_KEY="your-gemini-api-key-goes-here"

# Optional override for the port the Express server listens on.
PORT=3000

# Optional public URL where this application is hosted.
# Used for self-referential links and OAuth callbacks.
APP_URL="http://localhost:3000"

# Server-side encryption key for stored Gemini credentials.
# Provide a 64-character hex string (openssl rand -hex 32) or any passphrase
# (hashed internally). If unset, an ephemeral key is used and credentials do
# not persist across restarts/instances.
PONDER_ENCRYPTION_KEY="change-me-to-a-long-random-secret"

# Optional Firebase Admin service account JSON for account-scoped credential persistence.
# FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account",...}'

# Serper.dev API key used by the Express server for web search.
# Obtain one at https://serper.dev/.
SERPER_API_KEY="your-serper-api-key"

# Firebase client configuration (used by the browser). These are Firebase
# client identifiers, not secrets — but you should use your own project's
# values. For local development, copy them into a .env file.
VITE_FIREBASE_API_KEY="your-firebase-api-key"
VITE_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="000000000000"
VITE_FIREBASE_APP_ID="1:000000000000:web:0000000000000000"
# VITE_FIREBASE_MEASUREMENT_ID="G-XXXXXXXXXX"
# VITE_FIREBASE_FIRESTORE_DATABASE_ID="(default)"
