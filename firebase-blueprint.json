{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Public-safe application preferences for an authenticated ponder user (PII isolated in private subcollection).",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "maxLength": 80
        },
        "theme": {
          "type": "string",
          "enum": ["light", "dark"],
          "maxLength": 10
        },
        "preferredDepth": {
          "type": "string",
          "enum": ["quick", "standard", "deep"],
          "maxLength": 16
        },
        "soundEnabled": {
          "type": "boolean"
        },
        "soundVolume": {
          "type": "number"
        },
        "soundIntensity": {
          "type": "string",
          "enum": ["subtle", "balanced"],
          "maxLength": 16
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "theme", "preferredDepth", "soundEnabled", "soundVolume", "soundIntensity", "createdAt", "updatedAt"]
    },
    "UserPrivateInfo": {
      "title": "UserPrivateInfo",
      "description": "Isolated PII record containing authenticated user email and avatar URL.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "maxLength": 254
        },
        "photoURL": {
          "type": "string",
          "maxLength": 1024
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "updatedAt"]
    },
    "Conversation": {
      "title": "Conversation",
      "description": "Persistent concept exploration thread owned by an authenticated user.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerUid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "pinned": {
          "type": "boolean"
        },
        "depth": {
          "type": "string",
          "enum": ["quick", "standard", "deep"],
          "maxLength": 16
        },
        "messageCount": {
          "type": "integer"
        },
        "lastQuestion": {
          "type": "string",
          "maxLength": 1000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "ownerUid", "title", "pinned", "depth", "messageCount", "lastQuestion", "createdAt", "updatedAt"]
    },
    "ConversationMessage": {
      "title": "ConversationMessage",
      "description": "Single exploration turn inside a conversation, storing question, structured explanation, visualization config, and grounded citations.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "conversationId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerUid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "question": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "depth": {
          "type": "string",
          "enum": ["quick", "standard", "deep"],
          "maxLength": 16
        },
        "explanation": {
          "type": "object",
          "description": "Structured ponder explanation map with sections, interactive visualisation spec, glossary, understanding checks, citations, and media."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "conversationId", "ownerUid", "question", "depth", "explanation", "createdAt"]
    },
    "SavedExploration": {
      "title": "SavedExploration",
      "description": "User bookmark referencing a saved exploration turn.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerUid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "conversationId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "turnId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "question": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "savedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "ownerUid", "conversationId", "turnId", "title", "question", "savedAt"]
    },
    "PrivateNote": {
      "title": "PrivateNote",
      "description": "Private personal study note attached to a conversation, never included in public shares.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerUid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "conversationId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "content": {
          "type": "string",
          "maxLength": 10000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "ownerUid", "conversationId", "content", "createdAt", "updatedAt"]
    },
    "SharedExploration": {
      "title": "SharedExploration",
      "description": "Immutable public read-only exploration snapshot addressed by unpredictable high-entropy ID, excluding private notes and PII.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 16,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerUid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "question": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "explanation": {
          "type": "object",
          "description": "Sanitized public snapshot of the explanation and interactive visualisation config."
        },
        "schemaVersion": {
          "type": "integer"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "ownerUid", "question", "title", "explanation", "schemaVersion", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User non-PII settings and preferences document."
    },
    "/users/{userId}/private/{docId}": {
      "schema": { "$ref": "#/entities/UserPrivateInfo" },
      "description": "Isolated PII document storing authenticated user email and photoURL."
    },
    "/conversations/{conversationId}": {
      "schema": { "$ref": "#/entities/Conversation" },
      "description": "User-owned learning exploration threads."
    },
    "/conversations/{conversationId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/ConversationMessage" },
      "description": "Ordered turns inside a conversation."
    },
    "/savedExplorations/{savedId}": {
      "schema": { "$ref": "#/entities/SavedExploration" },
      "description": "Bookmarked exploration turns for quick review."
    },
    "/notes/{noteId}": {
      "schema": { "$ref": "#/entities/PrivateNote" },
      "description": "Private user study notes attached to a conversation."
    },
    "/shares/{shareId}": {
      "schema": { "$ref": "#/entities/SharedExploration" },
      "description": "Public read-only snapshot records addressed by high-entropy random ID."
    }
  }
}
